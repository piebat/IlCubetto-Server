# Copy this file to .env and fill in real values. Never commit .env.
#
# Load it before running the server or the test scripts, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or use a tool like python-dotenv / direnv if you prefer.

# MQTT broker (WebSocket + TLS) connection details.
CUBETTO_BROKER_HOST=broker.example.com
CUBETTO_BROKER_PORT=8883
CUBETTO_BROKER_WS_PATH=/mqtt
# Path to the CA certificate used to verify the broker's TLS certificate.
CUBETTO_BROKER_CA_CERT=/path/to/ca.crt
CUBETTO_BROKER_USERNAME=changeme
CUBETTO_BROKER_PASSWORD=changeme

# Optional: override the default MQTT topics.
# CUBETTO_TOPIC=cubetto/touch
# CUBETTO_VIBRATION_TOPIC=cubetto/vibrations
